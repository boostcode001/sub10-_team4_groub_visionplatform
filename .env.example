# 복사해서 사용:  cp .env.example .env   (.env 는 Git에 올리지 않음)

# ---- Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ---- PostgreSQL
POSTGRES_DB=vision_action
POSTGRES_USER=vision
POSTGRES_PASSWORD=change-me

# ---- IP Webcam 허용 목록 (key|화면 표시 이름|스트림 URL, 여러 개는 쉼표로 구분)
# 사용자는 화면에서 key 만 선택하고 URL을 입력하지 않는다.
IP_WEBCAMS=phone1|내 휴대폰|http://192.168.0.XX:8080/video
CAPTURE_SECONDS=8

# ---- 업로드·추론 한계
MAX_UPLOAD_MB=100
MAX_VIDEO_SECONDS=60
AI_READ_TIMEOUT=300
TARGET_PROCESS_FPS=15
INFERENCE_DEVICE=cpu

# ---- 학습 환경과 맞출 버전 (subject10 uv.lock 기준: scikit-learn 1.9.1, ultralytics 8.4.211)
#   python --version
#   pip show scikit-learn ultralytics | grep -E "Name|Version"
PYTHON_VERSION=3.12
SKLEARN_VERSION=1.9.1
ULTRALYTICS_VERSION=8.4.211

# ---- 개발용 FastAPI 공개 포트 (다른 프로젝트가 8001을 쓰면 변경)
FASTAPI_HOST_PORT=8001
# 8000을 다른 프로젝트가 쓰면 DJANGO_HOST_PORT=8010 으로 바꾸고 CSRF_TRUSTED_ORIGINS 도 같은 포트로 변경
DJANGO_HOST_PORT=8000

# ---- 사용할 모델: bash scripts/switch_model.sh basic|day06|team|team6 로 바꾼다
# [과제 기본 6동작, 평가 기준] 강사 제공 18클립 데이터 모델
ACTION_SET=basic
MODEL_FILE=rf_action_baseline.joblib
POSE_REFINER=none
HEAVY_MODEL_FILE=pose_landmarker_heavy.task
WINDOW_SECONDS=2.5
CONFIDENCE_THRESHOLD=
#
# [팀 재활 3동작] 팀원 모델 (MediaPipe heavy 관절)
# ACTION_SET=team
# MODEL_FILE=team/backup_3actions/rf_action_team.joblib
# POSE_REFINER=mediapipe_heavy
# WINDOW_SECONDS=3
# CONFIDENCE_THRESHOLD=0.55
